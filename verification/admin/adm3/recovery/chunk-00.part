test -f jc-backend/src/test/resources/db/canonical/30_admin_control_plane_hardening_smoke_test.sql
test ! -e database/journey-connect-db-v2.7/53_admin_control_plane_hardening.sql
test ! -e database/journey-connect-db-v2.7/54_admin_control_plane_hardening_smoke_test.sql

git mv database/journey-connect-db-v2.7/29_admin_control_plane_hardening.sql \
  database/journey-connect-db-v2.7/53_admin_control_plane_hardening.sql
git mv database/journey-connect-db-v2.7/30_admin_control_plane_hardening_smoke_test.sql \
  database/journey-connect-db-v2.7/54_admin_control_plane_hardening_smoke_test.sql
git mv jc-backend/src/test/resources/db/canonical/29_admin_control_plane_hardening.sql \
  jc-backend/src/test/resources/db/canonical/53_admin_control_plane_hardening.sql
git mv jc-backend/src/test/resources/db/canonical/30_admin_control_plane_hardening_smoke_test.sql \
  jc-backend/src/test/resources/db/canonical/54_admin_control_plane_hardening_smoke_test.sql

python <<'PY'
from __future__ import annotations

import hashlib
import json
import os
import re
from pathlib import Path

root = Path(".")
old_53 = "29_admin_control_plane_hardening.sql"
old_54 = "30_admin_control_plane_hardening_smoke_test.sql"
new_53 = "53_admin_control_plane_hardening.sql"
new_54 = "54_admin_control_plane_hardening_smoke_test.sql"

def read(path: str) -> str:
    return (root / path).read_text(encoding="utf-8")

def write(path: str, text: str) -> None:
    candidate = root / path
    candidate.parent.mkdir(parents=True, exist_ok=True)
    candidate.write_text(text, encoding="utf-8", newline="\n")

def replace_once(path: str, old: str, new: str) -> None:
    text = read(path)
    if old not in text:
        raise SystemExit(f"missing replacement anchor in {path}: {old[:120]!r}")
    write(path, text.replace(old, new, 1))

for tracked in os.popen("git ls-files").read().splitlines():
    candidate = root / tracked
    if not candidate.is_file():
        continue
    try:
        text = candidate.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        continue
    updated = (
        text.replace(old_53, new_53)
            .replace(old_54, new_54)
            .replace(
                "29_30_FORWARD_ONLY",
                "53_admin_control_plane_hardening.sql,54_admin_control_plane_hardening_smoke_test.sql",
            )
    )
    if updated != text:
        candidate.write_text(updated, encoding="utf-8", newline="\n")

adm3_workflow = ".github/workflows/adm3-admin-hardening.yml"
old_block = '''          for n in $(seq -w 1 30); do
            file=$(find jc-backend/src/test/resources/db/canonical -maxdepth 1 -name "${n}_*.sql" -print -quit)
